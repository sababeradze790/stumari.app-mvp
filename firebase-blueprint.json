{
  "entities": {
    "Property": {
      "title": "Property",
      "description": "Public rental property digital guide and stay manual (excludes private access credentials, exact street address, and personal host phone numbers)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "coverImage": { "type": "string" },
        "hostName": { "type": "string" },
        "checkInTime": { "type": "string" },
        "checkOutTime": { "type": "string" },
        "hasPrivateCredentials": { "type": "boolean" },
        "ownerId": { "type": "string" },
        "isDemo": { "type": "boolean" }
      },
      "required": ["id", "slug", "title", "city"]
    },
    "PropertyPrivateAccess": {
      "title": "PropertyPrivateAccess",
      "description": "Capability-token-gated check-in, Wi-Fi, exact address, and host direct contact details for authorized guests",
      "type": "object",
      "properties": {
        "wifiNetwork": { "type": "string" },
        "wifiPassword": { "type": "string" },
        "doorKeypadCode": { "type": "string" },
        "lockboxCode": { "type": "string" },
        "arrivalDirections": { "type": "string" },
        "parkingInstructions": { "type": "string" },
        "address": { "type": "string" },
        "hostPhone": { "type": "string" },
        "hostWhatsApp": { "type": "string" },
        "emergencyContact": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "PropertyHostSecrets": {
      "title": "PropertyHostSecrets",
      "description": "Owner-only record containing the active capability token and private credentials/contact details for host editing",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "accessToken": { "type": "string" },
        "wifiNetwork": { "type": "string" },
        "wifiPassword": { "type": "string" },
        "doorKeypadCode": { "type": "string" },
        "lockboxCode": { "type": "string" },
        "arrivalDirections": { "type": "string" },
        "parkingInstructions": { "type": "string" },
        "address": { "type": "string" },
        "hostPhone": { "type": "string" },
        "hostWhatsApp": { "type": "string" },
        "emergencyContact": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["ownerId", "accessToken"]
    },
    "StayFeedback": {
      "title": "StayFeedback",
      "description": "Private guest feedback and review routing for a property stay",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "propertyId": { "type": "string" },
        "hostId": { "type": "string" },
        "propertyName": { "type": "string" },
        "guestName": { "type": "string" },
        "sentiment": { "type": "string" },
        "comment": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "propertyId", "hostId", "sentiment", "createdAt"]
    },
    "StumariGem": {
      "title": "StumariGem",
      "description": "Curated local secret or host recommendation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "type": { "type": "string" },
        "experience": { "type": "string" },
        "distance": { "type": "string" },
        "priceLevel": { "type": "string" },
        "whyWeRecommend": { "type": "string" },
        "localTip": { "type": "string" }
      },
      "required": ["id", "ownerId", "title", "experience"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated host user profile and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "GuestRequest": {
      "title": "GuestRequest",
      "description": "One-tap guest request for linens, maintenance, climate or help",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "propertyId": { "type": "string" },
        "hostId": { "type": "string" },
        "propertyName": { "type": "string" },
        "guestName": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" },
        "urgency": { "type": "string" }
      },
      "required": ["id", "propertyId", "hostId", "category", "title", "createdAt", "status"]
    }
  },
  "firestore": {
    "/properties/{propertyId}": {
      "schema": { "$ref": "#/entities/Property" },
      "description": "Public property stay guides published by hosts (without sensitive credentials or private contact details)"
    },
    "/properties/{propertyId}/hostSecrets/{docId}": {
      "schema": { "$ref": "#/entities/PropertyHostSecrets" },
      "description": "Owner-only private credentials, exact address, contact numbers, and active guest capability token"
    },
    "/properties/{propertyId}/privateAccess/{accessToken}": {
      "schema": { "$ref": "#/entities/PropertyPrivateAccess" },
      "description": "Capability-token-gated check-in, Wi-Fi, exact address, and direct host contact details for guests"
    },
    "/feedbacks/{feedbackId}": {
      "schema": { "$ref": "#/entities/StayFeedback" },
      "description": "Private stay feedback submitted by guests"
    },
    "/gems/{gemId}": {
      "schema": { "$ref": "#/entities/StumariGem" },
      "description": "Curated Tbilisi local gems library and host secrets"
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/GuestRequest" },
      "description": "Guest requests submitted by guests and managed by hosts"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated host profile"
    }
  }
}
